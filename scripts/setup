#!/usr/bin/env bash
set -e

cd "$(dirname "$0")/.."

python3 -m pip install --upgrade pip
python3 -m pip install --requirement requirements_test.txt
# Runtime dependency declared in custom_components/bluetti/manifest.json -
# pytest-homeassistant-custom-component doesn't install it itself.
python3 -m pip install "pybluetti>=0.1.0"
