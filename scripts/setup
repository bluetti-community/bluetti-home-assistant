#!/usr/bin/env bash
set -e

cd "$(dirname "$0")/.."

python3 -m pip install --upgrade pip
python3 -m pip install --requirement requirements_test.txt
# Runtime dependencies declared in custom_components/bluetti/manifest.json -
# pytest-homeassistant-custom-component doesn't install them itself.
python3 -m pip install "pybluetti>=0.1.0" "modbus-connection[pymodbus]>=4.10.0"
