{
  "config": {
    "step": {
      "pick_implementation": {
        "title": "[%key:common::config_flow::title::oauth2_pick_implementation%]"
      }
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "already_in_progress": "[%key:common::config_flow::abort::already_in_progress%]",
      "oauth_error": "[%key:common::config_flow::abort::oauth2_error%]",
      "oauth_failed": "[%key:common::config_flow::abort::oauth2_failed%]",
      "oauth_timeout": "[%key:common::config_flow::abort::oauth2_timeout%]",
      "oauth_unauthorized": "[%key:common::config_flow::abort::oauth2_unauthorized%]",
      "missing_configuration": "[%key:common::config_flow::abort::oauth2_missing_configuration%]",
      "authorize_url_timeout": "[%key:common::config_flow::abort::oauth2_authorize_url_timeout%]",
      "no_url_available": "[%key:common::config_flow::abort::oauth2_no_url_available%]",
      "user_rejected_authorize": "[%key:common::config_flow::abort::oauth2_user_rejected_authorize%]",
      "all_devices_exists": "[%key:common::config_flow::abort::all_devices_exists%]",
      "no_devices_available": "[%key:common::config_flow::abort::no_devices_available%]",
      "cannot_connect": "[%key:common::config_flow::abort::cannot_connect%]",
      "success": "Successfully added your BLUETTI devices.",
      "reconfigure_failed": "[%key:common::config_flow::abort::reconfigure_no_matching_entry%]"
    },
    "create_entry": {
      "default": "[%key:common::config_flow::create_entry::authenticated%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "BLUETTI options",
        "description": "What would you like to do?",
        "menu_options": {
          "add_devices": "Add BLUETTI devices",
          "configure_modbus": "Configure local Modbus"
        }
      },
      "configure_modbus": {
        "title": "Configure local Modbus",
        "description": "Enter the local Modbus TCP connection details for this device. This is optional and supplements the cloud connection with additional sensors - it does not replace it.",
        "data": {
          "device_sn": "Device",
          "host": "Host",
          "port": "Port"
        }
      },
      "add_devices": {
        "title": "Add BLUETTI devices",
        "description": "Select any additional devices bound to your BLUETTI account that you want to add to Home Assistant.",
        "data": {
          "devices": "Devices"
        }
      }
    },
    "abort": {
      "no_devices_available": "[%key:common::config_flow::abort::no_devices_available%]",
      "all_devices_exists": "[%key:common::config_flow::abort::all_devices_exists%]",
      "cannot_connect": "[%key:common::config_flow::abort::cannot_connect%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]"
    }
  },
  "exceptions": {
    "command_failed": {
      "message": "Error sending command to {device_id}: {error}"
    },
    "select_option_read_only": {
      "message": "{fn_code} is read-only and cannot be changed"
    },
    "select_option_invalid": {
      "message": "Invalid option {option} for {fn_code}"
    },
    "modbus_error": {
      "message": "Error communicating with the device over Modbus: {error}"
    }
  },
  "issues": {
    "oauth_expired": {
      "title": "BLUETTI authentication expired",
      "description": "Your BLUETTI account authorization has expired. Go to the integration's settings and select **Reconfigure** to sign in again."
    },
    "websocket_error": {
      "title": "BLUETTI real-time updates unavailable",
      "description": "The BLUETTI cloud rejected the real-time update connection: {error}\n\nDevice data still updates by polling every 30 seconds; this only affects how quickly changes show up. If this persists, try removing and re-adding the integration."
    }
  },
